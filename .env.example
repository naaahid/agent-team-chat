# --- Agent Team Chat environment ---
# Database: SQLite file by default. To move to PostgreSQL later, change the
# provider in prisma/schema.prisma to "postgresql" and set a postgres URL here.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. CHANGE THIS before real use.
SESSION_SECRET="dev-only-secret-change-me-please-32chars"

# The very first Owner access code, created on first run if set.
# If you leave this out, the server generates one and prints it in the
# console on first start. After first login, change it from the Admin page.
INITIAL_OWNER_CODE="nahid-owner-2026"

# Name shown for the owner seat created on first run.
OWNER_NAME="Nahid"
